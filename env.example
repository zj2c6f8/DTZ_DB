<!DOCTYPE html>
<html><head><meta name="viewport" content="width=device-width, initial-scale=1">
<title>DTZ DB - Like MongoDB</title>
<style>
*{box-sizing:border-box;font-family:sans-serif}
body{background:#001e2b;color:white;margin:0;padding:15px}
h1{color:#00ed64} .card{background:#023430;border:1px solid #00ed64;padding:15px;border-radius:12px;margin-top:15px}
input,select{width:100%;padding:12px;margin:6px 0;border-radius:8px;border:none;background:#01161f;color:white}
button{width:100%;padding:12px;border:none;border-radius:8px;background:#00ed64;font-weight:bold;margin-top:6px;cursor:pointer}
button.red{background:#ff3b30;color:white} button.blue{background:#00aaff;color:white}
.doc{background:#01161f;padding:10px;border-radius:8px;margin:8px 0}
code{background:#000;padding:5px;border-radius:5px;color:#00ed64;word-break:break-all}
.hidden{display:none}
</style></head>
<body>
<h1>🍃 DTZ DB</h1><p>Mini MongoDB For Bot Developers - By <b>DTZ SITHU BABH</b></p>
<div id="loginBox" class="card">
<h2>Login / Signup</h2>
<input id="user" placeholder="Username"><input id="pass" type="password" placeholder="Password">
<button onclick="login()">Login / Create Account</button>
</div>
<div id="main" class="hidden">
<div class="card"><h3>🔑 Your API For Bots</h3>
<p>API Key: <code id="apiKey"></code></p>
<p>Bot URL:</p><code id="apiUrl"></code><br><br>
<button class="blue" onclick="copyApi()">Copy API URL</button></div>
<div class="card"><h3>📁 New Collection</h3>
<input id="colName" placeholder="ex: users, bots"><button onclick="addCol()">+ Create Collection</button></div>
<div class="card"><h3>📂 Collections</h3>
<select id="colSelect" onchange="showDocs()"></select>
<input id="docName" placeholder="Name"><input id="docData" placeholder="Data / Bot Name">
<button onclick="addDoc()">+ Add Document</button>
<input id="search" placeholder="🔍 Search..." onkeyup="showDocs()">
<div id="docs"></div>
<button class="red" onclick="logout()">Logout</button></div>
</div>
<script>
const API = ''; // Vercel එකේ නම් '' තියන්න, localhost නම් http://localhost:3000
let apiKey = localStorage.getItem('dtz_apiKey');
let username = localStorage.getItem('dtz_user');
let cols = JSON.parse(localStorage.getItem('dtz_cols')||'{}'); // collection list only local

async function login(){
  let u=document.getElementById('user').value.trim();
  let p=document.getElementById('pass').value;
  if(!u||!p) return alert('Username + Password දාන්න');
  let r=await fetch(API+'/api/auth',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:u,password:p})});
  let d=await r.json();
  if(d.error) return alert(d.error);
  apiKey=d.apiKey; username=u;
  localStorage.setItem('dtz_apiKey',apiKey); localStorage.setItem('dtz_user',u);
  start();
}
function start(){
  if(!apiKey) return;
  document.getElementById('loginBox').classList.add('hidden');
  document.getElementById('main').classList.remove('hidden');
  document.getElementById('apiKey').innerText=apiKey;
  document.getElementById('apiUrl').innerText=location.origin+'/api/data/'+apiKey+'/'+(document.getElementById('colSelect').value||'bots');
  renderCols(); showDocs();
}
function logout(){ localStorage.clear(); location.reload(); }
function addCol(){
  let n=document.getElementById('colName').value.trim().toLowerCase();
  if(!n) return alert('Collection Name දාන්න');
  if(!cols[username]) cols[username]=[];
  if(!cols[username].includes(n)) cols[username].push(n);
  localStorage.setItem('dtz_cols',JSON.stringify(cols));
  document.getElementById('colName').value=''; renderCols();
}
function renderCols(){
  let s=document.getElementById('colSelect'); s.innerHTML='';
  (cols[username]||[]).forEach(c=>s.innerHTML+=`<option value="${c}">${c}</option>`);
  if(!s.innerHTML) s.innerHTML='<option value="bots">bots</option>';
}
async function addDoc(){
  let col=document.getElementById('colSelect').value;
  let n=document.getElementById('docName').value;
  let d=document.getElementById('docData').value;
  if(!n) return alert('Name දාන්න');
  await fetch(API+'/api/data',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({apiKey,collection:col,name:n,data:d})});
  document.getElementById('docName').value=''; document.getElementById('docData').value=''; showDocs();
}
async function showDocs(){
  let col=document.getElementById('colSelect').value;
  let s=document.getElementById('search').value.toLowerCase();
  let r=await fetch(API+`/api/data/${apiKey}/${col}`);
  let list=await r.json();
  let box=document.getElementById('docs');
  document.getElementById('apiUrl').innerText=location.origin+`/api/data/${apiKey}/${col}`;
  if(!Array.isArray(list)) { box.innerHTML='No Data'; return; }
  box.innerHTML=list.filter(x=>x.name.toLowerCase().includes(s)).map(x=>`<div class="doc"><b>${x.name}</b><br><span style="color:#00ed64">${x.data}</span><br><button class="red" onclick="delDoc('${x._id}')">Delete</button></div>`).join('')||'No Data';
}
async function delDoc(id){
  await fetch(API+`/api/data/${apiKey}/${id}`,{method:'DELETE'}); showDocs();
}
function copyApi(){ navigator.clipboard.writeText(document.getElementById('apiUrl').innerText); alert('API URL Copied!'); }
if(apiKey) start();
</script></body></html>
